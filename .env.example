# Modelo
ANTHROPIC_API_KEY=
# Só para chaves sem workspace: ID do workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=
MODEL_NAME=claude-sonnet-5
MODEL_EFFORT=medium
MODEL_MAX_TOKENS=16000

# RAG
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=mesa_certa_kb
KNOWLEDGE_PATH=./data/knowledge
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.72
RAG_MAX_CONTEXT_CHARS=4000

# Banco
DATABASE_URL=sqlite:///./data/mesa_certa.db

# Agente
AGENT_MAX_ITERATIONS=8
SESSION_TTL_MINUTES=60
SESSION_MAX_MESSAGES=20

# Aplicação
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
TRACE_PATH=./data/traces
# Liga /traces, /admin/reindex e /reservations/{code}. Nunca em produção.
DEBUG_UI=false
# Relógio fixo para demo e avaliação (o seed é ancorado em 2026-09-15). Vazio: relógio real.
FIXED_NOW=
# Origens do front-end autorizadas (JSON).
CORS_ORIGINS=["http://localhost:3000"]
